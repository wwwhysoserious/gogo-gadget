<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ADB sockets to this device or to a device on the local network. The app never contacts the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network devices are found by mDNS (NsdManager); Android drops multicast packets unless the app holds a MulticastLock, which needs this normal permission. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- "This device" pairing: a short foreground service searches for this phone's pairing dialog and keeps the "Enter pairing code" notification alive while the dialog is on screen. shortService needs no extra permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 13+: show that notification (type the code there). Optional: the in-app code field always works. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Injected by the manifest merger because the ADB library declares minSdk 1; the app needs none of them. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.GoGoGadget">

        <!-- Zero-Trust: drop the exported receiver merged in by androidx.profileinstaller -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Pairs with this phone's own Wireless debugging from a notification. Never exported: only our own PendingIntents reach it. -->
        <service
            android:name=".PairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <!-- "Open with" on a package: the file is copied at once, since the grant is temporary. Content and file URIs only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/vnd.apkm" />
            </intent-filter>
            <!-- Bundles that file managers report as plain binary: matched by extension (pathPattern needs a host). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.[xX][aA][pP][kK]" />
                <data android:pathPattern=".*\\.[aA][pP][kK][mM]" />
                <data android:pathPattern=".*\\.[aA][pP][kK][sS]" />
            </intent-filter>
            <!-- Share. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".IconB"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconA"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_a"
            android:roundIcon="@mipmap/ic_launcher_a_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconC"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_c"
            android:roundIcon="@mipmap/ic_launcher_c_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
